{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apex-ui",
  "version": "0.1.0",
  "identifier": "com.apex.dev",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "APEX Terminal Ejecutiva",
        "width": 1200,
        "height": 800,
        "visible": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
